{
  "name": "openbrain-tui",
  "version": "0.1.0",
  "description": "OpenBrain TUI — use a .brain file as an interactive terminal agent",
  "type": "module",
  "main": "dist/cli.js",
  "bin": {
    "openbrain-tui": "./dist/cli.js"
  },
  "scripts": {
    "build": "esbuild src/index.jsx --bundle --platform=node --target=node18 --format=esm --packages=external --outfile=dist/cli.js --banner:js=\"#!/usr/bin/env node\"",
    "start": "node dist/cli.js",
    "dev": "npm run build && node dist/cli.js",
    "doctor": "node dist/cli.js --help"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "ink": "^5.0.1",
    "ink-spinner": "^5.0.0",
    "ink-text-input": "^6.0.0",
    "react": "^18.3.1"
  },
  "devDependencies": {
    "esbuild": "^0.24.0"
  },
  "engines": {
    "node": ">=18"
  }
}
