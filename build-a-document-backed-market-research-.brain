  "graph": {
    "nodes": [
      {
        "id": "memory-read",
        "type": "memory",
        "x": 0,
        "y": 0,
        "reason": "Provides prior conversation history to the research LLM so later runs build on previous findings.",
        "configuration": {}
      },
      {
        "id": "browser",
        "type": "browser",
        "x": 0,
        "y": 140,
        "reason": "Gathers real-time information from the company's official website to extract strategy, metrics, and statements.",
        "configuration": {
          "url": "https://www.apple.com/"
        }
      },
      {
        "id": "rag",
        "type": "rag",
        "x": 0,
        "y": 280,
        "reason": "Provides internal or external documents (e.g., analyst reports, whitepapers) to complement the live page data.",
        "configuration": {}
      },
      {
        "id": "research-llm",
        "type": "llm",
        "x": 260,
        "y": 0,
        "reason": "Core reasoning node that combines all three data sources (browser, rag, memory) and produces a cited analysis.",
        "configuration": {
          "instructions": "You are a market research analyst. You will receive three inputs: the content of a live company web page, relevant documents from a knowledge base, and prior conversation history from memory. Extract key facts, quotes, and metrics from both sources. Compare and contrast the information, noting agreements and contradictions. Cite sources for every claim (e.g., 'from live page' or 'from document'). Output a detailed analysis with citations."
        }
      },
      {
        "id": "memory-write",
        "type": "memory",
        "x": 520,
        "y": 0,
        "reason": "Stores the findings so that subsequent runs can build on prior context.",
        "configuration": {}
      },
      {
        "id": "analyst-llm",
        "type": "llm",
        "x": 520,
        "y": 140,
        "reason": "Transforms the raw analysis into a polished, structured report with sections: Executive Summary, Key Findings, Evidence vs. Gaps, Next Steps.",
        "configuration": {
          "instructions": "You are a report writer. You will receive the analysis from the research analyst. Write a structured market research report in Markdown with the following sections: Executive Summary, Key Findings with Citations, Evidence vs. Gaps, and Recommended Next Steps. Ensure all claims are cited from the provided analysis."
        }
      },
      {
        "id": "output",
        "type": "output",
        "x": 780,
        "y": 0,
        "reason": "Sink node that presents the final report to the user.",
        "configuration": {}
      }
    ],
