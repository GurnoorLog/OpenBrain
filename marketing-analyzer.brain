  "name": "Marketing Analyzer",
  "description": "Analyzes a company or product's marketing strategy: positioning, audience, channels, messaging, pricing, competitors, and recommendations.",
  "goal": "Given a company, product, or topic, produce a structured marketing analysis with actionable recommendations.",
  "provider": {
    "providerId": "fireworks",
    "model": ""
  },
  "memory": {
    "enabled": true,
    "kind": "working",
    "scope": "brain"
  },
