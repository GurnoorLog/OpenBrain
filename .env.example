# OpenBrain local-first configuration
# Copy to .env and fill in. Everything is OPTIONAL — local-only features
# (Ollama models, workspace files, .brain registry) need no keys.

# LLM + AI Architect provider (Fireworks). Required for cloud LLM nodes.
FIREWORKS_API_KEY=

# Composio — GitHub / MCP tool nodes.
COMPOSIO_API_KEY=
COMPOSIO_ACCOUNT_ID=
COMPOSIO_ENTITY_ID=

# Ports
OPENBRAIN_PORT=8080
MCP_GATEWAY_PORT=9000

# Optional infra
POSTGRES_USER=openbrain
POSTGRES_PASSWORD=openbrain
POSTGRES_DB=openbrain
POSTGRES_PORT=5432
REDIS_PORT=6379
QDRANT_PORT=6333
SUPABASE_DB_PASSWORD=openbrain
SUPABASE_DB_PORT=5433
