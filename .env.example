# OpenBrain local-first configuration
# Copy to .env and fill in. Everything is OPTIONAL — local-only features
# (Ollama models, workspace files, .brain registry) need no keys.

# LLM + AI Architect provider (Fireworks). Required for cloud LLM nodes.
FIREWORKS_API_KEY=

# Composio — GitHub / MCP tool nodes.
COMPOSIO_API_KEY=
COMPOSIO_ACCOUNT_ID=
COMPOSIO_ENTITY_ID=

# Ports
OPENBRAIN_PORT=8080
# If you run a native Ollama on the host (already on 11434), set OLLAMA_PORT=11435.
OLLAMA_PORT=11434
MCP_GATEWAY_PORT=9000

# Optional infra
POSTGRES_USER=openbrain
POSTGRES_PASSWORD=openbrain
POSTGRES_DB=openbrain
POSTGRES_PORT=5432
REDIS_PORT=6379
QDRANT_PORT=6333
SUPABASE_DB_PASSWORD=openbrain
SUPABASE_DB_PORT=5433

# Client build-time (Vite) config — baked into the SPA when building.
# Copy the exact same values you use in the app's .env.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_FIREWORKS_API_KEY=
VITE_CLOUD_EXECUTOR_URL=
VITE_COMPOSIO_API_KEY=
VITE_COMPOSIO_ACCOUNT_ID=
VITE_COMPOSIO_ENTITY_ID=
VITE_HF_TOKEN=
VITE_RUNTIME_URL=
